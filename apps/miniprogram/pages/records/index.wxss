.record__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.metric-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 24rpx;
}

.metric {
  width: calc(50% - 10rpx);
  padding: 20rpx 24rpx;
  background-color: #f2f4f7;
  border-radius: 12rpx;
}

.metric__value {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
}

.metric__label {
  margin-top: 4rpx;
  color: #4a4a4a;
  font-size: 32rpx;
}

.record__flags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.record__flag-note {
  color: #4a4a4a;
  font-size: 32rpx;
}
