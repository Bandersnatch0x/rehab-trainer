.record__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.metric-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 24rpx;
}

.metric {
  width: calc(50% - 10rpx);
  padding: 24rpx;
  background-color: #f8fafc;
  border: 2rpx solid #cbd5e1;
  border-radius: 16rpx;
  text-align: center;
}

.metric__value {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.2;
  color: #1a4fa0;
  font-variant-numeric: tabular-nums;
}

.metric__label {
  margin-top: 8rpx;
  color: #334155;
  font-size: 32rpx;
  font-weight: 600;
}

.record__flags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.record__flag-note {
  color: #4a4a4a;
  font-size: 32rpx;
}
