.alert--critical {
  border-left: 12rpx solid #b91c1c;
  background-color: #fffaf9;
}

.alert--warning {
  border-left: 12rpx solid #b45309;
}

.alert--info {
  border-left: 12rpx solid #1a4fa0;
}

.alert__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.alert__time {
  color: #4a4a4a;
  font-size: 32rpx;
}

.alert__action {
  margin-top: 24rpx;
}
