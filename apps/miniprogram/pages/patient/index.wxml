<view class="page">
  <view class="page-title">活力健康档案</view>
  <view class="page-subtitle">记录坚持打卡的每一天，身体越来越轻松～</view>

  <view wx:if="{{demoMode}}" class="notice notice--warning">
    演示数据：当前为演示模式，展示预置演示患者与示例数据，不是真实患者信息。
  </view>

  <view class="card card--mascot">
    <view class="mascot-box">
      <text class="mascot-avatar">🦌</text>
      <view class="mascot-text">
        <view class="mascot-title">康复小模范 🌟</view>
        <view class="mascot-quote">坚持运动，活力满满！康康小鹿为您点赞～</view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="card" aria-role="status">正在加载健康档案…</view>
  <view wx:elif="{{error}}" class="card">
    <view class="notice notice--danger" aria-role="alert">{{error}}</view>
    <button wx:if="{{needBinding}}" class="btn btn--primary" style="margin-top:24rpx" bindtap="goBind">去绑定</button>
    <button class="btn btn--secondary" style="margin-top:24rpx" bindtap="loadData">重新加载</button>
  </view>
  <view wx:elif="{{overview && !overview.context.patient}}" class="card">尚未关联患者，请联系管理员完成绑定。</view>

  <view wx:if="{{overview && overview.context.patient}}" class="section">
    <view class="section-title">坚持跟练成就</view>
    <view class="card">
      <view class="stat-grid">
        <view class="stat-item">
          <view class="stat-value">{{overview.trainingCount}}</view>
          <view class="stat-label">近 30 天打卡 (次)</view>
        </view>
        <view class="stat-item">
          <view class="stat-value">{{overview.streakDays}}</view>
          <view class="stat-label">连续打卡 (天)</view>
        </view>
        <view class="stat-item">
          <view class="stat-value">{{overview.todayCount}}</view>
          <view class="stat-label">今日打卡 (次)</view>
        </view>
      </view>
      <view class="hint">按近 30 个自然日统计；今天尚未打卡时，连续天数从昨天计起。</view>
      <view wx:if="{{!overview.records.length}}" class="hint">这段时间还没有训练记录，一起慢慢积累吧。</view>
    </view>
  </view>

  <view wx:if="{{overview && overview.context.patient}}" class="section">
    <view class="section-title">基本信息</view>
    <view class="card">
      <view class="info-row">
        <text class="info-row__label">姓名</text>
        <text class="info-row__value">{{overview.context.patient.displayName}}</text>
      </view>
      <view class="info-row">
        <text class="info-row__label">出生年份</text>
        <text class="info-row__value">{{overview.context.patient.birthYear}}</text>
      </view>
      <view class="info-row">
        <text class="info-row__label">所属机构</text>
        <text class="info-row__value">{{overview.context.orgName}}</text>
      </view>
      <view class="info-row">
        <text class="info-row__label">当前记录人</text>
        <text class="info-row__value">{{overview.context.accountName}}</text>
      </view>
    </view>
  </view>

  <view class="hint">训练数据持续与机构端同步；医护端工作台可查阅详细康复方案。</view>
</view>
