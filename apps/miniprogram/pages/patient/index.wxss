.card--mascot {
  background: #FFF9E6;
  border-color: #FDE68A;
}

.mascot-box {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.mascot-avatar {
  font-size: 72rpx;
  background: #FEF3C7;
  border-radius: 50%;
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.mascot-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #92400E;
}

.mascot-quote {
  font-size: 32rpx;
  color: #B45309;
  margin-top: 6rpx;
}

.stat-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 12rpx 0;
}

.stat-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background-color: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
}

.stat-label {
  font-size: 34rpx;
  font-weight: 600;
  color: #334155;
  margin-top: 0;
}

.stat-value {
  font-size: 52rpx;
  font-weight: 800;
  color: #1A4FA0;
}
