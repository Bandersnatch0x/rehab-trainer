.bind__label {
  display: block;
  margin-bottom: 16rpx;
  color: #0f172a;
  font-size: 36rpx;
  font-weight: 700;
}

.bind__input {
  box-sizing: border-box;
  width: 100%;
  min-height: 112rpx;
  padding: 24rpx 28rpx;
  color: #0f172a;
  font-size: 40rpx;
  letter-spacing: 2rpx;
  background-color: #ffffff;
  border: 4rpx solid #94a3b8;
  border-radius: 16rpx;
}

button.bind__button {
  width: 100%;
  min-height: 160rpx;
  margin-top: 28rpx;
}

/* 原生 button 的禁用态默认把文字压到几乎不可读；这里给出可读的灰底深灰字。 */
.bind__button--off {
  color: #475569;
  background-color: #e2e8f0;
  border: 2rpx solid #94a3b8;
  box-shadow: none;
}
