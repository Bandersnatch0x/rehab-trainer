.hero__eyebrow {
  margin-bottom: 8rpx;
  color: #1a4fa0;
  font-size: 32rpx;
  font-weight: 700;
}

.entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 160rpx;
  padding: 36rpx;
  color: #ffffff;
  background-color: #1a4fa0;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 16rpx rgba(26, 79, 160, 0.25);
}

.entry:active {
  opacity: 0.9;
  transform: scale(0.99);
}

.entry__title {
  font-size: 42rpx;
  font-weight: 800;
}

.entry__desc {
  margin-top: 8rpx;
  color: #e6eefc;
  font-size: 32rpx;
}

.entry__arrow {
  margin-left: 24rpx;
  font-size: 52rpx;
  line-height: 1;
}

.entry-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.entry-tile {
  width: 100%;
  min-height: 140rpx;
  padding: 32rpx 36rpx;
  background-color: #ffffff;
  border: 2rpx solid #cbd5e1;
  border-radius: 20rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.entry-tile:active {
  background-color: #f1f5f9;
}

.entry-tile__body {
  flex: 1;
}

.entry-tile__title {
  font-size: 38rpx;
  font-weight: 700;
  color: #0f172a;
}

.entry-tile__desc {
  margin-top: 8rpx;
  color: #334155;
  font-size: 32rpx;
  line-height: 1.5;
}

.entry-tile__arrow {
  margin-left: 20rpx;
  font-size: 44rpx;
  color: #94a3b8;
  flex-shrink: 0;
}

.identity {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.identity__body {
  flex: 1;
}
