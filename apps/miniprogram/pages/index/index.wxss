.hero__eyebrow {
  margin-bottom: 8rpx;
  color: #123a78;
  font-size: 32rpx;
  font-weight: 600;
}

.entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 152rpx;
  padding: 32rpx;
  color: #ffffff;
  background-color: #1a4fa0;
  border-radius: 20rpx;
}

.entry__title {
  font-size: 40rpx;
  font-weight: 700;
}

.entry__desc {
  margin-top: 8rpx;
  color: #e6eefc;
  font-size: 32rpx;
}

.entry__arrow {
  margin-left: 24rpx;
  font-size: 52rpx;
  line-height: 1;
}

.entry-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.entry-tile {
  width: calc(50% - 12rpx);
  min-height: 184rpx;
  padding: 28rpx;
  background-color: #ffffff;
  border: 2rpx solid #d9d9d9;
  border-radius: 20rpx;
}

.entry-tile__title {
  font-size: 36rpx;
  font-weight: 600;
}

.entry-tile__desc {
  margin-top: 8rpx;
  color: #4a4a4a;
  font-size: 32rpx;
  line-height: 1.5;
}

.identity {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.identity__body {
  flex: 1;
}

.switch-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 168rpx;
  min-height: 88rpx;
  padding: 0 24rpx;
  color: #4a4a4a;
  font-size: 30rpx;
  background-color: #eceff3;
  border: 2rpx solid #8a8a8a;
  border-radius: 999rpx;
}
