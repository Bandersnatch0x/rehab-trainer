/**
 * 全局样式：适老化与医疗冷静色系基线。
 * - 适老化硬性约束：主操作按钮 ≥ 160rpx (80dp)，正文 ≥ 32rpx (16sp)；
 * - 对比度：严格遵从 WCAG AA（正文对背景 ≥ 4.5:1，主操作白字对深蓝 ≥ 8:1）；
 * - 医疗冷静色板：深海康复蓝 #1a4fa0，纯白卡片，冷灰白底 #f8fafc；
 * - 预警醒目：危险红 #b91c1c，告警黄 #b45309，达标绿 #1b5e20。
 */
page {
  background-color: #f8fafc;
  color: #0f172a;
  font-size: 32rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue",
    "Microsoft YaHei", sans-serif;
}

view,
text,
navigator {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 96rpx;
}

.page-title {
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.3;
  color: #0f172a;
}

.page-subtitle {
  margin-top: 12rpx;
  font-size: 32rpx;
  color: #334155;
  line-height: 1.5;
}

.section {
  margin-top: 40rpx;
}

.section-title {
  margin-bottom: 20rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #0f172a;
}

/* Accessible Card Container */
.card {
  margin-bottom: 28rpx;
  padding: 32rpx;
  background-color: #ffffff;
  border: 2rpx solid #cbd5e1;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.04);
}

.card-title {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #0f172a;
}

.muted {
  color: #334155;
  font-size: 32rpx;
}

.hint {
  margin-top: 24rpx;
  color: #475569;
  font-size: 30rpx;
  line-height: 1.6;
}

/* Prominent Notice Boxes */
.notice {
  display: flex;
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx;
  color: #0f3268;
  font-size: 32rpx;
  line-height: 1.6;
  background-color: #eaf1fb;
  border-left: 10rpx solid #1a4fa0;
  border-radius: 12rpx;
}

.notice--warning {
  color: #78350f;
  background-color: #fef3c7;
  border-left-color: #b45309;
}

.notice--danger {
  color: #7f1d1d;
  background-color: #fee2e2;
  border-left-color: #b91c1c;
  font-weight: 600;
}

/* Elderly-friendly Buttons: Main action >= 160rpx (80dp) */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 112rpx;
  padding: 0 36rpx;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
  text-align: center;
  border-radius: 18rpx;
  touch-action: manipulation;
}

.btn--primary,
.btn--elderly,
.btn--tall {
  min-height: 160rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
  background-color: #1a4fa0;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(26, 79, 160, 0.25);
}

.btn--danger {
  min-height: 160rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
  background-color: #b91c1c;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(185, 28, 28, 0.3);
}

.btn--secondary {
  color: #1a4fa0;
  background-color: #ffffff;
  border: 4rpx solid #1a4fa0;
}

.btn--block {
  width: 100%;
}

.btn--pressed {
  opacity: 0.88;
  transform: scale(0.99);
}

.btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.btn-row .btn {
  flex: 1;
}

/* Status Badges */
.badge {
  display: inline-block;
  padding: 8rpx 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
  border-radius: 999rpx;
}

.badge--info {
  color: #0f3268;
  background-color: #eaf1fb;
}

.badge--success {
  color: #1b5e20;
  background-color: #e8f5e9;
}

.badge--warning {
  color: #78350f;
  background-color: #fef3c7;
}

.badge--danger {
  color: #7f1d1d;
  background-color: #fee2e2;
}

.badge--neutral {
  color: #334155;
  background-color: #e2e8f0;
}

.divider {
  height: 2rpx;
  margin: 24rpx 0;
  background-color: #cbd5e1;
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
}

.info-row:last-child {
  border-bottom: none;
}

.info-row__label {
  flex: 0 0 220rpx;
  color: #334155;
  font-size: 32rpx;
}

.info-row__value {
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  text-align: right;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.chip {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 32rpx;
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 600;
  background-color: #ffffff;
  border: 2rpx solid #94a3b8;
  border-radius: 999rpx;
}

.chip--active {
  color: #ffffff;
  font-weight: 700;
  background-color: #1a4fa0;
  border-color: #1a4fa0;
}
