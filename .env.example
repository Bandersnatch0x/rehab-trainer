# 非秘密，可使用默认值。
POSTGRES_DB=rehab
POSTGRES_USER=rehab
API_PORT=8000
REHAB_AUTO_CREATE_SCHEMA=false

# 秘密，必须填写。密码建议使用随机十六进制，避免 URL 转义问题。
POSTGRES_PASSWORD=
REHAB_JWT_SECRET=
# 秘密，包含数据库密码，必须自行填写（模板里不留任何可用密码，避免被直接复用）。
# 格式：postgresql+psycopg://rehab:<与 POSTGRES_PASSWORD 相同的值>@postgres:5432/rehab
REHAB_DATABASE_URL=

# 预留配置，当前后端尚未消费这些字段，不代表已接通微信或 COS。
# AppID、地域、桶名、CDN 地址不是秘密，可为空，接入前按实际资源填写。
REHAB_WECHAT_APP_ID=
REHAB_COS_REGION=
REHAB_COS_BUCKET=
REHAB_CDN_BASE_URL=
# 秘密，无默认值；仅在未来集成启用后注入服务端。
REHAB_WECHAT_APP_SECRET=
REHAB_COS_SECRET_ID=
REHAB_COS_SECRET_KEY=
