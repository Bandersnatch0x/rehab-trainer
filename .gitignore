# 真实秘密文件：只保留模板 .env.example 与已提交的开发配置 .env.development
.env
.env.local
.env.*.local

# 本地面：过程产物与个人票据，不入版本控制（AGENTS.md「过程产物另分一路」）
# 例外：.agents/skills/ 是装配产物（native pack + 七份阶段技能），随仓分发
.agents/*
!.agents/skills/

# 临时产物：日志、截图、一次性证据（AGENTS.md「产物两分」）
.agent/tmp/

# 根目录训练视频素材：体积大，不入版本控制；正式素材走对象存储
# 只匹配仓库根目录，避免误伤 apps/android/app/src/main/assets
/assets/

# 构建缓存与外部安装物
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
build/
dist/
*.egg-info/
.gradle/

# Android
apps/android/**/build/
apps/android/.gradle/
apps/android/.kotlin/
apps/android/local.properties
.idea/

# 小程序
apps/miniprogram/miniprogram_npm/

# Web
apps/admin-web/dist/

# 运行期媒体落盘目录：上传的视频与会话数据不入版本控制
services/api/media/

# 阶段技能名 build 与上方构建缓存规则同名，后匹配优先，须在文件末尾再次放行
!.agents/skills/build/
